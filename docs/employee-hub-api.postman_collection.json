{
  "info": {
    "name": "Employee Hub API",
    "description": "Employee and scheduled shift API requests. Get a token first, then use it for the remaining requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "employee_id",
      "value": "1"
    },
    {
      "key": "shift_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"YOUR_USERNAME\",\n  \"password\": \"YOUR_PASSWORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"token\", response.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Lina\",\n  \"last_name\": \"Khalil\",\n  \"email\": \"lina@example.com\",\n  \"phone_number\": \"0599000000\",\n  \"hourly_rate\": \"8.50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/employees/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                ""
              ]
            }
          }
        },
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/employees/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                ""
              ]
            }
          }
        },
        {
          "name": "Update hourly rate",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hourly_rate\": \"9.25\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/employees/{{employee_id}}/hourly-rate/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employee_id}}",
                "hourly-rate",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Scheduled shifts",
      "item": [
        {
          "name": "Create shift",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_datetime\": \"2026-10-12T09:00:00+03:00\",\n  \"end_datetime\": \"2026-10-12T17:00:00+03:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/employees/{{employee_id}}/shifts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employee_id}}",
                "shifts",
                ""
              ]
            }
          }
        },
        {
          "name": "List employee shifts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/employees/{{employee_id}}/shifts/?from=2026-10-01&to=2026-10-31",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employee_id}}",
                "shifts",
                ""
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-10-01"
                },
                {
                  "key": "to",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        },
        {
          "name": "Get shift",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/shifts/{{shift_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shifts",
                "{{shift_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Update shift times",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"end_datetime\": \"2026-10-12T18:00:00+03:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/shifts/{{shift_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shifts",
                "{{shift_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Delete shift",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/shifts/{{shift_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shifts",
                "{{shift_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Forecast pay",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/employees/{{employee_id}}/forecasted-pay/?from=2026-10-01&to=2026-10-31",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employee_id}}",
                "forecasted-pay",
                ""
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-10-01"
                },
                {
                  "key": "to",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Authorization",
        "type": "string"
      },
      {
        "key": "value",
        "value": "Token {{token}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  }
}
